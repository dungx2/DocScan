# Copy this file to .env and fill in your values
# $ cp .env.example .env

# Flask
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=false
PORT=5000

# DocScan processing
DOCSCAN_OUTPUT_MODE=binary          # binary | grayscale | color
DOCSCAN_BINARIZE=adaptive           # adaptive | sauvola | otsu

# AI model — set to your downloaded weights file path
# Leave empty to run Phase 1 (traditional CV) only
DOCSCAN_MODEL_PATH=models/training/best_model.pth

# PyTorch device: auto | cpu | cuda | cuda:0
DOCSCAN_DEVICE=auto
